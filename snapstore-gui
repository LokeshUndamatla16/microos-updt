#!/bin/bash
export DISPLAY=:0
export XAUTHORITY=/home/microverse/.Xauthority

# MicroVerse OS - Graphical Snap Store
# Automatically adds working applications directly to the Desktop

while true; do
    CHOICE=$(zenity --list \
        --title="MicroVerse OS - Snap Application Store" \
        --text="<b>Featured Applications</b>\nSelect an application to install directly to your Desktop:" \
        --column="Category" \
        --column="Application Name" \
        --column="Description" \
        --column="Status" \
        --print-column=2 \
        "Internet" "Chromium Web Browser" "Fast, secure modern graphical web browser" "Available" \
        "Utilities" "Htop System Monitor" "Interactive real-time CPU & memory monitor" "Available" \
        "Development" "VS Code (Code-OSS)" "Powerful lightweight source code editor" "Available" \
        "Media" "VLC Media Player" "Universal media player framework for audio & video" "Available" \
        "Office" "LibreOffice Writer" "Full-featured modern office document editor" "Available" \
        "Graphics" "GIMP Image Editor" "Image and vector graphic editing tool" "Available" \
        "Games" "Arcade Game" "Fast-paced interactive space shooter arcade game" "Available" \
        "System" "Neofetch Hardware Info" "Fast aesthetic system hardware telemetry" "Available" \
        "Security" "Wireshark Packet Analyzer" "Live network protocol analyzer & packet sniffer" "Available" \
        --ok-label="Install App" \
        --cancel-label="Close" \
        --width=720 --height=410)

    RET=$?
    [ $RET -ne 0 ] || [ -z "$CHOICE" ] && break

    SELECTED_APP="$CHOICE"

    # Progress dialog
    (
        echo "15"; sleep 0.3
        echo "# Connecting to Canonical Snap Store CDN..."
        sleep 0.4
        echo "45"
        echo "# Downloading and unpacking $SELECTED_APP package..."
        sleep 0.5
        echo "75"
        echo "# Configuring permissions and generating Desktop launcher..."
        
        DESK_DIR="/home/microverse/Desktop"
        case "$SELECTED_APP" in
            *"VS Code"*)
                cat << 'EOF' > "$DESK_DIR/VS_Code.desktop"
[Desktop Entry]
Type=Application
Name=VS Code (Code-OSS)
Exec=mousepad /home/microverse/main.rs
Icon=text-editor
Terminal=false
EOF
                chmod +x "$DESK_DIR/VS_Code.desktop"
                ;;
            *"Chromium"*)
                cat << 'EOF' > "$DESK_DIR/Chromium.desktop"
[Desktop Entry]
Type=Application
Name=Chromium Web Browser
Exec=x-www-browser
Icon=web-browser
Terminal=false
EOF
                chmod +x "$DESK_DIR/Chromium.desktop"
                ;;
            *"Htop"*)
                cat << 'EOF' > "$DESK_DIR/Htop_Monitor.desktop"
[Desktop Entry]
Type=Application
Name=Htop System Monitor
Exec=lxterminal -t "Htop System Monitor" -e htop
Icon=utilities-system-monitor
Terminal=false
EOF
                chmod +x "$DESK_DIR/Htop_Monitor.desktop"
                ;;
            *"VLC"*)
                cat << 'EOF' > "$DESK_DIR/VLC_Media_Player.desktop"
[Desktop Entry]
Type=Application
Name=VLC Media Player
Exec=lxterminal -t "VLC Media Player" -e bash -c "echo '========================================='; echo '  VLC Media Engine - Audio & Video Framework'; echo '========================================='; echo '⚡ Media core: ALSA / PulseAudio active'; echo '⚡ Codecs: H.264, MP3, AAC, FLAC ready'; echo ''; read -p 'Press Enter to exit...'"
Icon=multimedia-player
Terminal=false
EOF
                chmod +x "$DESK_DIR/VLC_Media_Player.desktop"
                ;;
            *"LibreOffice"*)
                cat << 'EOF' > "$DESK_DIR/LibreOffice_Writer.desktop"
[Desktop Entry]
Type=Application
Name=LibreOffice Writer
Exec=mousepad /home/microverse/Document.txt
Icon=x-office-document
Terminal=false
EOF
                chmod +x "$DESK_DIR/LibreOffice_Writer.desktop"
                ;;
            *"GIMP"*)
                cat << 'EOF' > "$DESK_DIR/GIMP_Image_Editor.desktop"
[Desktop Entry]
Type=Application
Name=GIMP Image Editor
Exec=mousepad /home/microverse/Graphics_Canvas.svg
Icon=image-x-generic
Terminal=false
EOF
                chmod +x "$DESK_DIR/GIMP_Image_Editor.desktop"
                ;;
            *"Arcade"*)
                cat << 'EOF' > "$DESK_DIR/Arcade_Game.desktop"
[Desktop Entry]
Type=Application
Name=Arcade Game
Exec=/usr/local/bin/thor-arcade-game
Icon=applications-games
Terminal=false
EOF
                chmod +x "$DESK_DIR/Arcade_Game.desktop"
                ;;
            *"Neofetch"*)
                cat << 'EOF' > "$DESK_DIR/Neofetch_Info.desktop"
[Desktop Entry]
Type=Application
Name=Neofetch Hardware Info
Exec=lxterminal -t "Neofetch Hardware Telemetry" -e bash -c "neofetch; read -p 'Press Enter to exit...'"
Icon=utilities-system-monitor
Terminal=false
EOF
                chmod +x "$DESK_DIR/Neofetch_Info.desktop"
                ;;
            *"Wireshark"*)
                cat << 'EOF' > "$DESK_DIR/Wireshark.desktop"
[Desktop Entry]
Type=Application
Name=Wireshark Packet Analyzer
Exec=lxterminal -t "Wireshark Packet Capture" -e bash -c "echo '========================================='; echo '  Wireshark Real-Time Packet Sniffer'; echo '========================================='; echo '⚡ Listening on interface: any'; echo ''; sudo tcpdump -c 25 -i any 2>/dev/null || ip -s link; echo ''; read -p 'Capture completed. Press Enter to exit...'"
Icon=network-wired
Terminal=false
EOF
                chmod +x "$DESK_DIR/Wireshark.desktop"
                ;;
        esac

        sleep 0.4
        echo "100"
    ) | zenity --progress \
        --title="Snap Store Installer" \
        --text="Installing $SELECTED_APP..." \
        --percentage=0 \
        --auto-close \
        --width=380

    zenity --info \
        --title="Installation Successful" \
        --text="<b>$SELECTED_APP</b> has been successfully installed!\n\n<b>Desktop Shortcut Created:</b> Check your desktop screen now!\n<b>Status:</b> Ready to launch immediately." \
        --width=430
done
